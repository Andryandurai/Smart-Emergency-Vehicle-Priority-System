# ---------------------------------------------------------------------------
# SEVPS environment configuration.  Copy to `.env` and edit.
# Every value below has a working default - the platform boots with no .env.
# ---------------------------------------------------------------------------

SEVPS_SECRET_KEY=change-me-in-production
SEVPS_DEBUG=1
SEVPS_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database --------------------------------------------------------------
# sqlite   -> zero-config, ships by default (bbox + haversine radius search)
# postgres -> PostgreSQL; with SEVPS_ENABLE_POSTGIS=1 the migration creates
#             generated geography columns and GiST indexes, and radius search
#             becomes an indexed ST_DWithin. GDAL is NOT required for this.
SEVPS_DB_ENGINE=sqlite
SEVPS_DB_NAME=sevps
SEVPS_DB_USER=sevps
SEVPS_DB_PASSWORD=sevps
# Setting a host while DB_ENGINE=sqlite also defines a `postgres` alias, which
# is what `manage.py migrate_to_postgres` migrates into.
SEVPS_DB_HOST=
SEVPS_DB_PORT=5432
SEVPS_DB_CONN_MAX_AGE=60
SEVPS_ENABLE_POSTGIS=0
# Opt into the GeoDjango GIS backend for its ORM expressions. Requires GDAL on
# the host; SEVPS does not need it otherwise.
SEVPS_USE_GEODJANGO=0

# --- Real-time channel layer ----------------------------------------------
# Empty  -> in-memory layer (single process, fine for dev / pilot demos)
# Set    -> redis://127.0.0.1:6379/0  (needs `pip install channels-redis`)
SEVPS_REDIS_URL=

# --- Mapping / GIS providers ----------------------------------------------
# SEVPS routes on its own OpenStreetMap-derived graph by default.  These keys
# only enable optional live-traffic enrichment.
SEVPS_MAPBOX_TOKEN=
SEVPS_GOOGLE_MAPS_KEY=
SEVPS_OSRM_URL=
SEVPS_TRAFFIC_PROVIDER=internal          # internal | mapbox | google

# --- AI engine tuning ------------------------------------------------------
SEVPS_GREEN_CORRIDOR_LOOKAHEAD_S=120     # preempt a signal this far ahead
SEVPS_SIGNAL_MAX_HOLD_S=90               # safety cap on a forced green
SEVPS_DRIVER_ALERT_RADIUS_M=800          # broadcast radius for Layer 4
SEVPS_CONGESTION_MODEL_PATH=             # optional joblib model for sklearn

# --- Computer vision -------------------------------------------------------
# simulated -> synthesises plausible detections (no OpenCV needed)
# yolo      -> real YOLOv8 inference (needs ultralytics + opencv)
SEVPS_CV_MODE=simulated
SEVPS_CV_MODEL=yolov8n.pt

# --- Authentication (Phase 2) ----------------------------------------------
SEVPS_JWT_ACCESS_MINUTES=15
SEVPS_JWT_REFRESH_DAYS=7
# Defaults to SEVPS_SECRET_KEY. Set separately to rotate signing keys without
# invalidating sessions and CSRF tokens at the same time.
SEVPS_JWT_SIGNING_KEY=

# --- Simulation ------------------------------------------------------------
SEVPS_SIM_TICK_SECONDS=2
