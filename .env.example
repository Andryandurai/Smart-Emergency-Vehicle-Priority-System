# ---------------------------------------------------------------------------
# SEVPS environment configuration.  Copy to `.env` and edit.
# Every value below has a working default - the platform boots with no .env.
# ---------------------------------------------------------------------------

SEVPS_SECRET_KEY=change-me-in-production
SEVPS_DEBUG=1
SEVPS_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database --------------------------------------------------------------
# sqlite   -> zero-config, ships by default (bbox + haversine radius search)
# postgres -> PostgreSQL; with SEVPS_ENABLE_POSTGIS=1 the migration creates
#             generated geography columns and GiST indexes, and radius search
#             becomes an indexed ST_DWithin. GDAL is NOT required for this.
SEVPS_DB_ENGINE=sqlite
SEVPS_DB_NAME=sevps
SEVPS_DB_USER=sevps
SEVPS_DB_PASSWORD=sevps
# Setting a host while DB_ENGINE=sqlite also defines a `postgres` alias, which
# is what `manage.py migrate_to_postgres` migrates into.
SEVPS_DB_HOST=
SEVPS_DB_PORT=5432
SEVPS_DB_CONN_MAX_AGE=60
SEVPS_ENABLE_POSTGIS=0
# Opt into the GeoDjango GIS backend for its ORM expressions. Requires GDAL on
# the host; SEVPS does not need it otherwise.
SEVPS_USE_GEODJANGO=0

# --- Real-time channel layer ----------------------------------------------
# Empty  -> in-memory layer (single process, fine for dev / pilot demos)
# Set    -> redis://127.0.0.1:6379/0  (needs `pip install channels-redis`)
SEVPS_REDIS_URL=

# --- Mapping / GIS providers ----------------------------------------------
# SEVPS routes on its own OpenStreetMap-derived graph by default.  These keys
# only enable optional live-traffic enrichment.
SEVPS_MAPBOX_TOKEN=
SEVPS_GOOGLE_MAPS_KEY=
SEVPS_OSRM_URL=
SEVPS_TRAFFIC_PROVIDER=internal          # internal | mapbox | google

# --- AI engine tuning ------------------------------------------------------
SEVPS_GREEN_CORRIDOR_LOOKAHEAD_S=120     # preempt a signal this far ahead
SEVPS_SIGNAL_MAX_HOLD_S=90               # safety cap on a forced green
SEVPS_DRIVER_ALERT_RADIUS_M=800          # broadcast radius for Layer 4
SEVPS_CONGESTION_MODEL_PATH=             # optional joblib model for sklearn

# --- Computer vision -------------------------------------------------------
# simulated -> synthesises plausible detections (no OpenCV needed)
# yolo      -> real YOLOv8 inference (needs ultralytics + opencv)
SEVPS_CV_MODE=simulated
SEVPS_CV_MODEL=yolov8n.pt

# --- Authentication (Phase 2) ----------------------------------------------
SEVPS_JWT_ACCESS_MINUTES=15
SEVPS_JWT_REFRESH_DAYS=7
# Defaults to SEVPS_SECRET_KEY. Set separately to rotate signing keys without
# invalidating sessions and CSRF tokens at the same time.
SEVPS_JWT_SIGNING_KEY=

# --- Simulation ------------------------------------------------------------
SEVPS_SIM_TICK_SECONDS=2

# --- Notifications / Web Push (Phase 9) ------------------------------------
# Generate once per deployment:  python manage.py generate_vapid_keys
# For a read-only container filesystem use --print-only and set these instead.
#
# Rotating this key invalidates EVERY push subscription: every controller,
# hospital and crew must re-grant notification permission, and they find out
# only when an alert fails to arrive. Treat it as deployment identity.
SEVPS_VAPID_PRIVATE_KEY=
SEVPS_VAPID_PUBLIC_KEY=
SEVPS_VAPID_KEY_PATH=
# RFC 8292 requires a contactable URI so a push service operator can reach the
# sender about abuse. Change this from the default before going live.
SEVPS_VAPID_SUBJECT=mailto:ops@sevps.local
# Optional: only needed for native Android clients holding an FCM registration
# token. Browsers do not need it - see docs/NOTIFICATIONS.md.
SEVPS_FCM_CREDENTIALS=
SEVPS_PUSH_DRIVER_ALERTS=1

# --- Deployment (Phase 11) -------------------------------------------------
# Applied automatically whenever SEVPS_DEBUG=0.
#
# TLS terminates at nginx or a load balancer, so Django reads the scheme from
# X-Forwarded-Proto rather than assuming it. Set to 0 only if TLS terminates
# on this process.
SEVPS_BEHIND_TLS_PROXY=1
# Leave redirection to the edge when nginx is in front. With both redirecting,
# a misconfigured forwarded header produces an infinite loop that presents as
# an application outage.
SEVPS_SECURE_SSL_REDIRECT=0
SEVPS_HSTS_SECONDS=31536000
SEVPS_HSTS_SUBDOMAINS=1
# OFF by default, deliberately. Preload submission is close to irreversible -
# removal takes months to reach browsers, and until then every subdomain is
# unreachable over plain HTTP. Enable once the whole estate, including
# roadside controllers, is known to be TLS.
SEVPS_HSTS_PRELOAD=0
SEVPS_CSRF_TRUSTED_ORIGINS=

# --- Docker Compose only (not Django settings) -----------------------------
SEVPS_WEB_REPLICAS=2
SEVPS_HTTP_PORT=80
SEVPS_WEB_PORT=8000
SEVPS_DB_WAIT_ATTEMPTS=60
