.git
.gitignore

# The frontend is built inside the image by the Node stage. Copying these in
# would add hundreds of megabytes and, worse, could shadow the freshly built
# dist with whatever a developer last built on their laptop.
frontend/node_modules/
frontend/dist/
node_modules/
__pycache__
*.py[cod]
.venv
venv
env

# Never bake a database or a dump into the image.
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
migration/
.env

staticfiles/
media/
models/
*.joblib
*.pt

.idea
.vscode
.pytest_cache
.coverage
htmlcov
docs/
README.md
